{
  "name": "schul-apps",
  "productName": "Schul-Apps",
  "version": "0.4.33",
  "description": "Werkzeuge für Unterrichtsmaterial und Organisatorisches",
  "main": "./out/main/index.js",
  "author": "Torge Kornahrens",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:win": "node scripts/exe-bauen.mjs",
    "prepare:assets": "node scripts/prepare-openmoji.mjs",
    "test:e2e": "electron-vite build && node tests/e2e/smoke.mjs test-results && node tests/e2e/worksheet.mjs test-results/arbeitsblatt && node tests/e2e/grids.mjs test-results/gitternetze && node tests/e2e/exam.mjs test-results/klassenarbeit",
    "build:mobil": "vite build -c vite.mobil.config.ts",
    "dev:mobil": "vite -c vite.mobil.config.ts",
    "ios:sync": "npm run build:mobil && npx cap sync ios"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@google/genai": "^2.22.0",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "fflate": "^0.8.3",
    "mammoth": "1.12.3",
    "node-forge": "^1.4.0",
    "openai": "7.16.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@mantine/core": "9.6.1",
    "@mantine/dropzone": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@mantine/notifications": "9.6.1",
    "@tabler/icons-react": "3.46.0",
    "@types/node": "24.13.5",
    "@types/node-forge": "^1.3.14",
    "@types/papaparse": "5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "buffer": "^6.0.3",
    "docx": "9.7.1",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "hyphen": "^1.14.1",
    "jsqr": "^1.4.0",
    "mathjax-full": "^3.2.2",
    "openmoji": "17.0.0",
    "papaparse": "5.7.0",
    "path-browserify": "^1.0.1",
    "pdfjs-dist": "6.3.289",
    "playwright-core": "^1.63.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "9.3.10",
    "schulapps-nativ": "file:plugins/schulapps-nativ",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "zustand": "5.0.15"
  }
